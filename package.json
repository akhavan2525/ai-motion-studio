{
  "name": "ai-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ادیتور هوشمند موشن‌گرافیک با چت فارسی و موتور انیمیشن اختصاصی",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "make": "tsx scripts/make.ts",
    "render": "tsx scripts/render.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "remotion studio packages/animation-engine/src/entry.ts",
    "desktop:dev": "npm run dev --prefix apps/desktop",
    "desktop:build": "npm run build --prefix apps/desktop",
    "desktop:install": "npm install --prefix apps/desktop",
    "desktop:start": "npm start --prefix apps/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/vazirmatn": "^5.2.8",
    "@remotion/bundler": "^4.0.539",
    "@remotion/cli": "^4.0.539",
    "@remotion/player": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.539",
    "zod": "^3.25.76"
  }
}
